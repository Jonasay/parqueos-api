generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique @db.VarChar(50)
  activo   Boolean   @default(true)
  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id            Int         @id @default(autoincrement())
  email         String      @unique @db.VarChar(150)
  password_hash String
  estado        String      @db.VarChar(20)
  activo        Boolean     @default(true)
  rol_id        Int
  rol           Rol         @relation(fields: [rol_id], references: [id])
  empleado      Empleado?
  cliente       Cliente?
  audit_logs    AuditLog[]

  @@map("usuarios")
}

model Empleado {
  id              Int       @id @default(autoincrement())
  usuario_id      Int       @unique
  dpi             String?   @db.VarChar(20)
  numero_igss     String?   @db.VarChar(30)
  codigo_empleado String?   @db.VarChar(30)
  turno_asignado  String?   @db.VarChar(50)
  activo          Boolean   @default(true)
  usuario         Usuario   @relation(fields: [usuario_id], references: [id])
  tickets         Ticket[]

  @@map("empleados")
}

model Cliente {
  id                 Int        @id @default(autoincrement())
  usuario_id         Int        @unique
  nit_facturacion    String?    @db.VarChar(30)
  nombre_facturacion String?    @db.VarChar(150)
  telefono           String?    @db.VarChar(30)
  activo             Boolean    @default(true)
  usuario            Usuario    @relation(fields: [usuario_id], references: [id])
  vehiculos          Vehiculo[]

  @@map("clientes")
}

model Sucursal {
  id                Int             @id @default(autoincrement())
  nombre            String          @db.VarChar(150)
  direccion         String
  telefono_contacto String?         @db.VarChar(30)
  capacidad_maxima  Int
  activo            Boolean         @default(true)
  niveles_parqueo   NivelParqueo[]

  @@map("sucursales")
}

model NivelParqueo {
  id               Int               @id @default(autoincrement())
  sucursal_id      Int
  nombre_nivel     String            @db.VarChar(100)
  activo           Boolean           @default(true)
  sucursal         Sucursal          @relation(fields: [sucursal_id], references: [id])
  espacios_parqueo EspacioParqueo[]

  @@map("niveles_parqueo")
}

model EstadoEspacio {
  id               Int               @id @default(autoincrement())
  nombre           String            @unique @db.VarChar(50)
  activo           Boolean           @default(true)
  espacios_parqueo EspacioParqueo[]

  @@map("estados_espacio")
}

model TipoVehiculo {
  id               Int               @id @default(autoincrement())
  nombre           String            @unique @db.VarChar(100)
  activo           Boolean           @default(true)
  espacios_parqueo EspacioParqueo[]
  tarifas          Tarifa[]

  @@map("tipos_vehiculo")
}

model EspacioParqueo {
  id               Int           @id @default(autoincrement())
  nivel_id         Int
  estado_id        Int
  tipo_vehiculo_id Int
  es_techado       Boolean       @default(false)
  activo           Boolean       @default(true)
  nivel            NivelParqueo  @relation(fields: [nivel_id], references: [id])
  estado           EstadoEspacio @relation(fields: [estado_id], references: [id])
  tipo_vehiculo    TipoVehiculo  @relation(fields: [tipo_vehiculo_id], references: [id])
  tickets          Ticket[]

  @@map("espacios_parqueo")
}

model Vehiculo {
  id         Int        @id @default(autoincrement())
  placa      String     @unique @db.VarChar(20)
  color      String?    @db.VarChar(50)
  marca      String?    @db.VarChar(100)
  cliente_id Int?
  activo     Boolean    @default(true)
  cliente    Cliente?   @relation(fields: [cliente_id], references: [id])
  tickets    Ticket[]
  pensiones  Pension[]

  @@map("vehiculos")
}

model Ticket {
  id                  Int            @id @default(autoincrement())
  codigo_ticket       String         @unique @default(uuid()) @db.Uuid
  vehiculo_id         Int
  espacio_id          Int
  hora_entrada        DateTime       @db.Timestamp()
  hora_salida         DateTime?      @db.Timestamp()
  empleado_ingreso_id Int
  estado              String         @db.VarChar(20)
  activo              Boolean        @default(true)
  vehiculo            Vehiculo       @relation(fields: [vehiculo_id], references: [id])
  espacio             EspacioParqueo @relation(fields: [espacio_id], references: [id])
  empleado_ingreso    Empleado       @relation(fields: [empleado_ingreso_id], references: [id])
  pagos               Pago[]

  @@map("tickets")
}

model Pension {
  id          Int      @id @default(autoincrement())
  vehiculo_id Int
  fecha_inicio DateTime @db.Date
  fecha_fin   DateTime? @db.Date
  estado_pago String   @db.VarChar(50)
  activo      Boolean  @default(true)
  vehiculo    Vehiculo @relation(fields: [vehiculo_id], references: [id])

  @@map("pensiones")
}

model Tarifa {
  id               Int          @id @default(autoincrement())
  tipo_vehiculo_id Int
  monto            Decimal      @db.Decimal(10, 2)
  tipo_cobro       String       @db.VarChar(50)
  estado_activo    Boolean      @default(true)
  tipo_vehiculo    TipoVehiculo @relation(fields: [tipo_vehiculo_id], references: [id])

  @@map("tarifas")
}

model MetodoPago {
  id     Int     @id @default(autoincrement())
  nombre String  @unique @db.VarChar(100)
  activo Boolean @default(true)
  pagos  Pago[]

  @@map("metodos_pago")
}

model Pago {
  id                  Int        @id @default(autoincrement())
  ticket_id           Int
  total_pagado        Decimal    @db.Decimal(10, 2)
  metodo_pago_id      Int
  fecha_pago          DateTime   @db.Timestamp()
  numero_autorizacion String?    @db.VarChar(100)
  requiere_fel        Boolean    @default(false)
  activo              Boolean    @default(true)
  ticket              Ticket     @relation(fields: [ticket_id], references: [id])
  metodo_pago         MetodoPago @relation(fields: [metodo_pago_id], references: [id])

  @@map("pagos")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  accion     String   @db.VarChar(255)
  fecha_hora DateTime @db.Timestamp()
  detalles   Json?
  activo     Boolean  @default(true)
  usuario    Usuario  @relation(fields: [usuario_id], references: [id])

  @@map("audit_logs")
}